<div id="map" role="region" aria-label="उत्तर प्रदेश का इंटरैक्टिव नक्शा और परत नियंत्रण">
  <svg id="svg" data-m="dt" role="img" aria-labelledby="map-svg-title" aria-describedby="map-svg-desc">
    <title id="map-svg-title">उत्तर प्रदेश का विधानसभा और बूथ नक्शा</title>
    <desc id="map-svg-desc">डिफ़ॉल्ट रूप से ज़िलों का रंग बूथ-गाँव लिंक कवरेज दिखाता है और गहराई अभियान प्रगति दिखाती है। परत बदलने के लिए नक्शे के ऊपर दिए बटन और विवरण के लिए ड्रिल-डाउन विधानसभा चयन का उपयोग करें।</desc>
    <g id="g">
      <g id="gd"></g>
      <g id="gp"></g>
      <g id="ga"></g>
      <g id="gs"></g>
      <g id="gg"></g>
      <g id="gt"></g>
      <g id="gv"></g>
      <g id="gh"></g>
    </g>
  </svg>
  <div id="tip" aria-hidden="true"></div>

  <div id="map-bans" class="map-bans" role="group" aria-label="लक्ष्य और मुख्य संख्याएँ">
    <div class="map-gauge">
      <svg viewBox="0 0 320 180" aria-hidden="true">
        <path class="map-gauge-track" d="M 20 160 A 140 140 0 0 1 300 160" pathLength="100"></path>
        <path id="map-gauge-fill" class="map-gauge-fill" d="M 20 160 A 140 140 0 0 1 300 160" pathLength="100" style="--progress:<%= Math.min(100, (vm.progress.current / vm.progress.target) * 100).toFixed(2) %>"></path>
      </svg>
      <div class="map-gauge-center">
        <span>प्रगति</span>
        <b id="map-ban-pct"><%= ((vm.progress.current / vm.progress.target) * 100).toFixed(1) %>%</b>
      </div>
    </div>
    <div class="map-bans-row">
      <div class="map-ban"><span>वर्तमान पहुँच</span><b id="map-ban-current"><%= num(vm.progress.current) %></b></div>
      <div class="map-ban"><span>लक्ष्य</span><b id="map-ban-target"><%= num(vm.progress.target) %></b></div>
    </div>
  </div>

  <div id="panchayat-view" aria-hidden="true">
    <div class="panchayat-overlay">
      <div id="panchayat-readout" aria-live="polite"></div>
    </div>
  </div>

  <div class="mapui">
    <div class="layers" role="group" aria-label="नक्शे की परतें">
      <button type="button" class="layer-quick" data-layer="campaign" aria-pressed="true">अभियान</button>

      <details class="layer-group" data-group-label="प्रशासनिक">
        <summary aria-label="प्रशासनिक परतें चुनें">
          <span class="layer-group-name">प्रशासनिक</span>
          <span class="layer-group-current"></span>
          <span class="chev" aria-hidden="true"></span>
        </summary>
        <div class="layer-menu" role="group" aria-label="प्रशासनिक परतें">
          <button type="button" data-layer="dt" aria-pressed="false">ज़िले · बूथ</button>
          <button type="button" data-layer="pc" aria-pressed="false">लोकसभा</button>
          <button type="button" data-layer="ac" aria-pressed="false">विधानसभा</button>
          <button type="button" data-layer="sd" aria-pressed="false">तहसील</button>
        </div>
      </details>

      <details class="layer-group" data-group-label="गाँव · पंचायत">
        <summary aria-label="गाँव और पंचायत परतें चुनें">
          <span class="layer-group-name">गाँव · पंचायत</span>
          <span class="layer-group-current"></span>
          <span class="chev" aria-hidden="true"></span>
        </summary>
        <div class="layer-menu" role="group" aria-label="गाँव और पंचायत परतें">
          <button type="button" data-layer="panchayat" aria-pressed="false">पंचायत</button>
          <button type="button" data-layer="villages" aria-pressed="false">गाँव</button>
          <button type="button" data-layer="network" aria-pressed="false">ग्राम नेटवर्क</button>
        </div>
      </details>

      <details class="layer-group" data-group-label="विश्लेषण">
        <summary aria-label="विश्लेषण परतें चुनें">
          <span class="layer-group-name">विश्लेषण</span>
          <span class="layer-group-current"></span>
          <span class="chev" aria-hidden="true"></span>
        </summary>
        <div class="layer-menu" role="group" aria-label="विश्लेषण परतें">
          <button type="button" data-layer="density" aria-pressed="false">घनत्व</button>
          <button type="button" data-layer="index" aria-pressed="false">सूचकांक</button>
        </div>
      </details>
    </div>

    <div class="map-pc-filter" role="group" aria-label="लोकसभा फ़िल्टर">
      <label class="sr" for="map-pc-filter">लोकसभा फ़िल्टर</label>
      <select id="map-pc-filter" data-pc-filter>
        <option value="">लोकसभा: सभी</option>
        <% vm.pcOptions.forEach((pc) => { %>
        <option value="<%= pc.no %>">PC <%= pc.no %> · <%= pc.name %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div id="network-view" aria-hidden="true">
    <div class="network-heading">
      <p class="network-k" lang="en">UTTAR PRADESH · VILLAGE NETWORK</p>
      <h2 id="network-title">गाँव और ग्राम पंचायत</h2>
      <p id="network-subtitle">बड़ा वृत्त ग्राम पंचायत है। छोटा वृत्त टीम सदस्य है।</p>
    </div>
    <svg id="network-svg" role="group" aria-label="ग्राम पंचायत समूह, टीम सदस्य वृत्त, और एक ही विधानसभा की सम्बन्ध रेखाएँ"></svg>
    <div class="network-zoom-btns" role="group" aria-label="नेटवर्क ज़ूम">
      <button type="button" id="network-zoom-in" title="ज़ूम इन" aria-label="ज़ूम इन">+</button>
      <button type="button" id="network-zoom-out" title="ज़ूम आउट" aria-label="ज़ूम आउट">−</button>
      <button type="button" id="network-zoom-reset" title="ज़ूम रीसेट" aria-label="ज़ूम रीसेट">↺</button>
    </div>
    <div class="network-legend" role="group" aria-label="ग्राम नेटवर्क की कुंजी">
      <span><i class="network-legend-dot"></i> टीम सदस्य · वृत्त, आकार = प्रभाव</span>
      <span><i class="network-legend-pradhan"></i> ग्राम प्रधान · पीला घेरा</span>
      <span><i class="network-legend-ring"></i> ग्राम पंचायत समूह</span>
      <span><i class="network-legend-line"></i> एक ही विधानसभा की निकट पंचायतें</span>
      <span><i class="network-legend-influence"></i> क्लिक: गाँव की टीम और प्रभाव-स्तर</span>
      <span><i class="network-legend-boundary"></i> SOI गाँव संदर्भ</span>
    </div>
    <div id="influence-panel" class="influence-panel" role="dialog" aria-modal="false" aria-labelledby="influence-title" aria-describedby="influence-subtitle" tabindex="-1">
      <div class="influence-panel-head">
        <div>
          <h3 id="influence-title">प्रभाव विवरण</h3>
          <p id="influence-subtitle">टीम सदस्य चुनें</p>
        </div>
        <button type="button" id="influence-close" class="influence-close" aria-label="प्रभाव विवरण बंद करें">×</button>
      </div>
      <svg id="influence-svg" role="img" aria-label="प्रभाव का ग्रे बबल चार्ट"></svg>
      <div class="influence-legend">ग्रे बबल: चुने सदस्य के प्रभाव-स्तर का विवरण</div>
    </div>
    <div id="network-tip" aria-hidden="true"></div>
  </div>

  <div class="mapfoot">
    <div class="legend" id="legend" role="group" aria-label="नक्शे की कुंजी"></div>
    <div id="mapstat" role="status" aria-live="polite"></div>
    <div class="mapbtns">
      <button type="button" id="zoom-in" title="ज़ूम इन" aria-label="ज़ूम इन">+</button>
      <button type="button" id="zoom-out" title="ज़ूम आउट" aria-label="ज़ूम आउट">−</button>
      <button type="button" id="zoom-reset" title="रीसेट" aria-label="नक्शा रीसेट">↺</button>
      <button type="button" id="hq-toggle" title="मुख्यालय" aria-label="मुख्यालय दिखाएँ" aria-pressed="false">◉</button>
    </div>
  </div>
</div>
