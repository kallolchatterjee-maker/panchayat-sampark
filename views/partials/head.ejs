<!doctype html>
<html lang="hi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>उत्तर प्रदेश पंचायत अभियान · नक्शा</title>
<meta name="description" content="उत्तर प्रदेश की 403 विधानसभाओं, 1,01,653 गाँवों, ग्राम पंचायतों और 1,77,516 बूथों का इंटरैक्टिव नक्शा।">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap">
<script>
  // Apply the saved theme before CSS paints so the page never flashes.
  (function () {
    try {
      var saved = localStorage.getItem('ps-theme');
      document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
    } catch (e) {
      document.documentElement.dataset.theme = 'dark';
    }
  })();
</script>
<link rel="stylesheet" href="/css/app.css?v=<%= vm.v %>&amp;ui=29">
<script src="/js/zoom-check.js" defer></script>
<script src="/js/theme.js?v=<%= vm.v %>&amp;ui=2" defer></script>
</head>
<body>
