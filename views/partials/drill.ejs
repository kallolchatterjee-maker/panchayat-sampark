<section class="step" data-m="drill" id="drill">
  <div class="card dark">
    <p class="k"><span lang="en">DRILL-DOWN · AC → VILLAGE → BOOTH</span></p>
    <h2>विधानसभा से <span class="or">गाँव तक</span></h2>

    <div class="pc-filter">
      <div class="pc-filter-head">
        <label for="pc-select">लोकसभा फ़िल्टर</label>
      </div>
      <select id="pc-select" data-pc-filter>
        <option value="">सभी लोकसभा · <%= num(vm.pcOptions.length) %> सीटें</option>
        <% vm.pcOptions.forEach((pc) => { %>
        <option value="<%= pc.no %>">PC <%= pc.no %> · <%= pc.name %> · <%= num(pc.acCount) %> विधानसभा</option>
        <% }) %>
      </select>
      <p class="sm pc-filter-status" id="pc-filter-status" role="status" aria-live="polite">सभी लोकसभा दिखाई जा रही हैं।</p>
    </div>

    <label class="sr" for="sel">विधानसभा चुनें</label>
    <select id="sel">
      <option value="">— विधानसभा चुनें —</option>
      <% vm.acOptions.forEach((ac) => { %>
      <option value="<%= ac.no %>"><%= ac.name %> · <%= ac.district %> · <%= num(ac.booths) %> बूथ</option>
      <% }) %>
    </select>

    <div class="search">
      <label class="sr" for="q">गाँव खोजें</label>
      <p class="sr" id="search-hint">कम से कम दो अक्षर लिखें। परिणाम आने पर Tab दबाकर सूची में जाएँ और Enter से चुनें।</p>
      <input id="q" type="search" placeholder="गाँव / ग्राम पंचायत / बूथ लेबल खोजें…" autocomplete="off" aria-describedby="search-hint">
      <div class="results" id="results" role="group" aria-label="खोज परिणाम"></div>
      <p class="sr" id="search-status" role="status" aria-live="polite"></p>
    </div>

    <p class="sr" id="drill-status" role="status" aria-live="polite"></p>

    <div class="panel" id="panel" tabindex="-1">
      <p class="loading" id="prompt">विधानसभा चुनें या नक्शे पर क्लिक करें।</p>
    </div>
  </div>
</section>
