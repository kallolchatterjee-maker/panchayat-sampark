<section class="step step-team" data-m="team" data-map-hidden id="team">
  <div class="card team-card">
    <p class="k"><span lang="en">TEAM APPOINTMENT</span> · टीम संरचना</p>
    <h2>टीम <span class="or">नियुक्ति</span></h2>

    <div class="team-kpis" role="group" aria-label="टीम नियुक्ति की मुख्य संख्याएँ">
      <div class="team-kpi"><b><%= num(vm.team.totals.appointed) %></b><span>नियुक्त</span></div>
      <div class="team-kpi"><b><%= num(vm.team.totals.contacted) %></b><span>संपर्क हुआ</span></div>
      <div class="team-kpi"><b><%= num(vm.team.totals.verified) %></b><span>सत्यापित</span></div>
      <div class="team-kpi"><b><%= num(vm.team.totals.dutyYes) %></b><span>दायित्व: हाँ</span></div>
      <div class="team-kpi"><b><%= num(vm.team.totals.acs) %>/<%= num(vm.team.totals.acsTarget) %></b><span>विधानसभा टीम</span></div>
    </div>

    <div class="team-bar" role="group" aria-label="टीम संरचना नियंत्रण">
      <label class="sr" for="team-search">नाम, ज़िला या विधानसभा खोजें</label>
      <input type="search" id="team-search" placeholder="नाम, ज़िला या विधानसभा खोजें" autocomplete="off">
      <button type="button" id="team-expand">सब खोलें</button>
      <button type="button" id="team-collapse">सब बंद करें</button>
      <button type="button" id="team-zoom-out" aria-label="टीम संरचना ज़ूम घटाएँ">−</button>
      <button type="button" id="team-zoom-in" aria-label="टीम संरचना ज़ूम बढ़ाएँ">+</button>
      <button type="button" id="team-fit">एक दृश्य में</button>
      <button type="button" data-theme-toggle class="theme-toggle" aria-label="लाइट मोड चालू करें">
        <span class="theme-toggle-icon" aria-hidden="true">☀</span>
        <span class="theme-toggle-text">लाइट मोड</span>
      </button>
    </div>

    <div class="team-canvas-stage">
      <canvas id="team-canvas" tabindex="0" role="img"
        aria-label="प्रदेश से विधानसभा तक टीम संरचना। खींचकर हिलाएँ, स्क्रॉल या बटन से ज़ूम करें, शून्य से एक दृश्य में फिट करें।"></canvas>
      <ul class="sr" id="team-tree" aria-label="प्रदेश से विधानसभा तक टीम संरचना"></ul>
    </div>
  </div>
</section>
