<section class="step" data-m="villages">
  <div class="card">
    <p class="k"><span lang="en">VILLAGES &amp; GRAM PANCHAYATS</span></p>
    <h2><%= num(vm.meta.totals.villages) %> गाँव,<br><span class="or"><%= num(vm.meta.totals.gps) %> ग्राम पंचायत</span></h2>

    <div class="tiles">
      <div class="tile"><b><%= num(vm.meta.totals.blocks) %></b><span>विकास खंड / ब्लॉक</span></div>
      <div class="tile"><b><%= num(vm.meta.match.villagesWithBooths) %></b><span>गाँव जिनमें बूथ जुड़े</span></div>
      <div class="tile"><b><%= pct(vm.meta.match.boothCoveragePct / 100) %></b><span>बूथ लिंक कवरेज</span></div>
      <div class="tile"><b><%= num(vm.meta.villagesWithoutGp) %></b><span>गाँव बिना GP कोड</span></div>
    </div>
    <% if (vm.meta.urbanAcs.length) { %>
    <div class="alert">
      पूरी तरह शहरी, बिना गाँव बहुभुज: 
      <%= vm.meta.urbanAcs.map((a) => a.name).join(' · ') %>
    </div>
    <% } %>
  </div>
</section>
