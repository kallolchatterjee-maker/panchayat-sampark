<section class="step" data-m="index">
  <div class="card">
    <p class="k"><span lang="en">BOOTH SATURATION INDEX · 0–100</span></p>
    <h2>हर विधानसभा का <span class="or">एक स्कोर</span></h2>
    <p class="sm">असली डेटा से बना समग्र सूचकांक — हर घटक का प्रतिशत-रैंक, भार के साथ।</p>

    <% vm.weights.forEach((w) => { %>
    <div class="comp">
      <div class="head"><span><%= w.label %></span><b><%= w.weight %>%</b></div>
      <div class="bar" aria-hidden="true"><i style="width: <%= w.weight %>%"></i></div>
    </div>
    <% }) %>

    <h3>शीर्ष 5</h3>
    <table>
      <caption>सूचकांक में शीर्ष 5 विधानसभाएँ</caption>
      <thead>
        <tr><th scope="col">विधानसभा</th><th scope="col">सूचकांक</th></tr>
      </thead>
      <tbody>
        <% vm.indexTop.forEach((ac) => { %>
        <tr><td><%= ac.name %><small><%= ac.district %> · <%= num(ac.booths) %> बूथ</small></td><td><%= decimal(ac.index, 1) %></td></tr>
        <% }) %>
      </tbody>
    </table>

    <h3>अंतिम 5</h3>
    <table>
      <caption>सूचकांक में अंतिम 5 विधानसभाएँ</caption>
      <thead>
        <tr><th scope="col">विधानसभा</th><th scope="col">सूचकांक</th></tr>
      </thead>
      <tbody>
        <% vm.indexBottom.forEach((ac) => { %>
        <tr><td><%= ac.name %><small><%= ac.district %> · <%= num(ac.booths) %> बूथ</small></td><td><%= decimal(ac.index, 1) %></td></tr>
        <% }) %>
      </tbody>
    </table>

    <p class="note">
      सूचकांक में 100 में से 20 अंक बूथ-गाँव लिंक कवरेज का है, जो नाम-मिलान की
      गुणवत्ता भी दर्शाता है — इसे ज़मीनी सत्य न मानें। बिना गाँव वाली सीटों पर
      उपलब्ध घटकों से भार पुनः सामान्यीकृत होते हैं।
    </p>
    <p class="src">परिभाषा: बूथ/गाँव (25) · बूथ/वर्ग किमी (30) · लिंक कवरेज (20) ·
      GP/वर्ग किमी (15) · बूथ/ग्राम पंचायत (10)</p>
  </div>
</section>
