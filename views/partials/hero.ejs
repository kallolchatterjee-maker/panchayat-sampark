<section class="step on" data-m="campaign" id="hero">
  <div class="card dark hero-card">
    <p class="k"><span lang="en">UTTAR PRADESH · 2026</span></p>
    <h1>उत्तर प्रदेश<br><span class="or">पंचायत अभियान</span></h1>

    <div class="ban-strip" id="hero-bans" role="group" aria-label="मुख्य अभियान संख्याएँ">
      <div class="ban">
        <b><%= num(vm.meta.totals.villages) %></b>
        <span>गाँव</span>
      </div>
      <div class="ban">
        <b><%= num(vm.meta.totals.gps) %></b>
        <span>ग्राम पंचायत</span>
      </div>
      <div class="ban">
        <b><%= num(vm.meta.totals.booths) %></b>
        <span>बूथ</span>
      </div>
    </div>

    <div class="tiles">
      <div class="tile"><b><%= num(vm.meta.totals.acs) %></b><span>विधानसभा</span></div>
      <div class="tile"><b><%= num(vm.meta.totals.pc) %></b><span>लोकसभा</span></div>
      <div class="tile"><b><%= num(vm.meta.totals.districts) %></b><span>ज़िले</span></div>
      <div class="tile"><b><%= num(vm.meta.totals.subdistricts) %></b><span>तहसील</span></div>
    </div>

    <p class="sm">
      <span class="tag">अभियान डेक</span> 8,76,980 निर्वाचित प्रतिनिधि · 2,121 ज़मीनी टीम
    </p>
  </div>
</section>
