<section class="step on" data-m="campaign" id="hero">
  <div class="card dark hero-card">
    <p class="k"><span lang="en">UTTAR PRADESH · 2026</span></p>
    <h1>उत्तर प्रदेश<br><span class="or">पंचायत अभियान</span></h1>
    <p>विधानसभा, गाँव, ग्राम पंचायत और बूथ — एक ही नक्शे पर।</p>

    <div class="ban-strip" id="hero-bans" role="group" aria-label="मुख्य अभियान संख्याएँ">
      <div class="ban">
        <b id="ban-current"><%= num(vm.progress.current) %></b>
        <span>वर्तमान पहुँच (डेमो)</span>
      </div>
      <div class="ban">
        <b><%= num(vm.meta.totals.villages) %></b>
        <span>गाँव</span>
      </div>
      <div class="ban">
        <b><%= num(vm.meta.totals.gps) %></b>
        <span>ग्राम पंचायत</span>
      </div>
      <div class="ban">
        <b><%= num(vm.meta.totals.booths) %></b>
        <span>बूथ</span>
      </div>
    </div>

    <div class="progress-gauge" id="hero-gauge" role="group" aria-label="लक्ष्य प्रगति">
      <div class="gauge-head">
        <span>लक्ष्य की ओर प्रगति</span>
        <b><span id="gauge-current-text"><%= num(vm.progress.current) %></span> / <span id="gauge-target-text"><%= num(vm.progress.target) %></span></b>
      </div>
      <div class="gauge-track" aria-hidden="true">
        <i id="gauge-fill" style="width:<%= Math.min(100, (vm.progress.current / vm.progress.target) * 100).toFixed(2) %>%"></i>
      </div>
      <div class="gauge-meta">
        <span id="gauge-pct"><%= ((vm.progress.current / vm.progress.target) * 100).toFixed(1) %>% पूर्ण</span>
        <span id="gauge-remaining"><%= num(Math.max(0, vm.progress.target - vm.progress.current)) %> शेष</span>
      </div>
      <p class="sm gauge-note">डेमो आँकड़े · <code>/api/progress</code> से अपडेट होगा</p>
      <p class="sm">नक्शा ज़िलों को बूथ-गाँव लिंक कवरेज से रंगता है; रंग की गहराई उपर वाली प्रगति के साथ बढ़ती है।</p>
    </div>

    <div class="tiles">
      <div class="tile"><b><%= num(vm.meta.totals.acs) %></b><span>विधानसभा</span></div>
      <div class="tile"><b><%= num(vm.meta.totals.pc) %></b><span>लोकसभा</span></div>
      <div class="tile"><b><%= num(vm.meta.totals.districts) %></b><span>ज़िले</span></div>
      <div class="tile"><b><%= num(vm.meta.totals.subdistricts) %></b><span>तहसील</span></div>
    </div>

    <p class="sm">
      <span class="tag">अभियान डेक</span> 8,76,980 निर्वाचित प्रतिनिधि · 2,121 ज़मीनी टीम
    </p>
    <p class="src">नक्शा और नीचे की सभी गणनाएँ <code>Data/</code> से · D3.js · सर्वर-रेंडर्ड</p>
  </div>
</section>
